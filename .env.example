# --- 数据库配置 ---
DB_NAME=ai_interview_ds
DB_USERNAME=nzy333
DB_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=root

# --- 用户自定义大模型配置加密密钥 (必须填写，否则用户无法保存自己的 API Key) ---
# 用于服务端加密存储用户填写的 OpenAI-compatible Provider API Key。
# 项目不提供系统兜底 key；普通用户需登录后在侧边栏“大模型配置”自行填写 DeepSeek/Kimi/GLM/Qwen/自定义兼容配置。
APP_LLM_CONFIG_ENCRYPTION_KEY=replace_with_a_strong_encryption_key

# --- JWT 签名密钥 (必须填写，至少 32 字符，生产环境使用强随机密钥) ---
JWT_SIGN_KEY=your_jwt_signing_key_at_least_32_characters

# --- 访问统计与限流 ---
APP_ANALYTICS_HASH_SALT=change_me_analytics_hash_salt
APP_RATE_LIMIT_ENABLED=true
# 开发者白名单：仅用于本地调试；管理入口使用登录用户的 ADMIN 角色授权
APP_DEVELOPER_EXEMPT_USER_IDS=
APP_DEVELOPER_EXEMPT_USERNAMES=
APP_DEVELOPER_EXEMPT_EMAILS=

# --- 题库维护 / Qdrant ---
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interview_atoms_e5_base
QDRANT_VECTOR_SIZE=768
QDRANT_CONNECT_TIMEOUT_MS=3000
QDRANT_READ_TIMEOUT_MS=5000
QUESTION_BANK_SEED_FROM_JSON=true
QUESTION_BANK_REINDEX_ON_STARTUP=true
# 比赛 Demo 默认只开放内置公共题库；设为 true 才恢复普通用户私有题库维护能力。
APP_QUESTION_BANK_USER_MAINTENANCE_ENABLED=false
APP_RAG_RETRIEVAL_LIMIT=20
APP_RAG_RETRIEVAL_LIMIT_MAX=30
APP_RAG_CONTEXT_LIMIT=10
APP_RAG_HIGH_CONFIDENCE_SCORE=0.70
APP_RAG_MIN_CONTEXT_SCORE=0.55

# --- 有边界面试 Agent ---
APP_INTERVIEW_AGENT_ENABLED=true
APP_INTERVIEW_AGENT_PLANNING_TIMEOUT_SECONDS=35
APP_INTERVIEW_AGENT_MAX_TOOL_CALLS=3
APP_INTERVIEW_AGENT_FALLBACK_ENABLED=true

# --- Embedding 检索模型 ---
APP_EMBEDDING_PROVIDER=http
APP_EMBEDDING_ENDPOINT=http://embedding-service:8000/embed
APP_EMBEDDING_QUERY_PREFIX=query:
APP_EMBEDDING_PASSAGE_PREFIX=passage:
APP_EMBEDDING_CONNECT_TIMEOUT_MS=3000
APP_EMBEDDING_READ_TIMEOUT_MS=10000
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# --- 邮件服务配置 (必须填写，否则注册/忘记密码功能无法使用) ---
# QQ邮箱: 登录 mail.qq.com → 设置 → 账户 → 开启 POP3/SMTP 服务 → 获取授权码
# 163邮箱: MAIL_HOST=smtp.163.com，其余类似
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# --- 前端配置 ---
VITE_API_BASE_URL=http://localhost:8080
