# Overlay for cloud internal testing. Copy to .env.external.prod (ignored by Git).
# Base database, SMTP and signing/encryption settings remain in .env.prod.
APP_EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
APP_EMBEDDING_API_KEY=replace_with_your_embedding_api_key
APP_EMBEDDING_MODEL=text-embedding-v4
APP_EMBEDDING_BATCH_SIZE=10
APP_EMBEDDING_READ_TIMEOUT_MS=15000
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=interview_atoms_v4_prod
QDRANT_VECTOR_SIZE=768
QDRANT_CONNECT_TIMEOUT_MS=5000
QDRANT_READ_TIMEOUT_MS=15000
APP_QUESTION_BANK_USER_MAINTENANCE_ENABLED=false
# This username and email must BOTH match a new email-verified registration.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
# Conservative starting values, not a proven 2 GB memory limit.
APP_KNOWLEDGE_BUILD_MAX_FILE_SIZE_BYTES=5242880
APP_KNOWLEDGE_BUILD_MAX_FILES=1
APP_KNOWLEDGE_BUILD_MAX_TEXT_CHARS=200000
APP_KNOWLEDGE_BUILD_MAX_CHUNKS=10
APP_KNOWLEDGE_BUILD_MAX_CANDIDATES=60
